# Copy to .env and fill in. Never commit .env.

# 1 = never touch the network; use cache and fixtures only.
OFFLINE=0

# Meta Model API (OpenAI-compatible). Leave the key empty to run in deterministic local mode.
META_API_BASE_URL=https://api.meta.ai/v1
# The Meta docs name this variable MODEL_API_KEY; either name works.
META_API_KEY=
META_MODEL=muse-spark-1.3

# Server address for `python run.py`
SKYTRACE_HOST=127.0.0.1
SKYTRACE_PORT=8600
