# Copy to .env and fill in. Never commit .env.

# 1 = never touch the network; use cache and fixtures only.
OFFLINE=0

# Meta Model API (OpenAI-compatible). Leave the key empty to run in deterministic local mode.
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
META_MODEL=muse-spark-1.3

# Where downloads and caches live (relative to the repo root unless absolute).
SKYTRACE_CACHE_DIR=cache
